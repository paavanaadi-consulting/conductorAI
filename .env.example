# =============================================================================
# ConductorAI Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are optional — defaults work for local development.
# =============================================================================

# General Settings
CONDUCTOR_ENVIRONMENT=dev          # dev | staging | prod
CONDUCTOR_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
CONDUCTOR_ENABLE_PERSISTENCE=false # true to use Redis, false for in-memory

# Redis Configuration (only needed if enable_persistence=true)
CONDUCTOR_REDIS__URL=redis://localhost:6379/0
CONDUCTOR_REDIS__MAX_CONNECTIONS=10
CONDUCTOR_REDIS__KEY_PREFIX=conductor:
CONDUCTOR_REDIS__SOCKET_TIMEOUT=5.0

# LLM Provider Configuration
CONDUCTOR_LLM__PROVIDER=mock      # mock | openai | anthropic
CONDUCTOR_LLM__MODEL=gpt-4
CONDUCTOR_LLM__API_KEY=
CONDUCTOR_LLM__TEMPERATURE=0.7
CONDUCTOR_LLM__MAX_TOKENS=4096

# Workflow Settings
CONDUCTOR_MAX_AGENT_RETRIES=3
CONDUCTOR_WORKFLOW_TIMEOUT_SECONDS=300
CONDUCTOR_ENABLE_CONTEXT_GENERATION=true

# Secrets (used by SecretsProvider)
# CONDUCTOR_SECRET_REDIS_PASSWORD=
# CONDUCTOR_SECRET_LLM_API_KEY=
