# ConductorAI UI — Backend Environment Variables

# LLM Configuration
CONDUCTOR_UI_CONDUCTOR_LLM_PROVIDER=mock          # mock | openai | anthropic
CONDUCTOR_UI_CONDUCTOR_LLM_MODEL=gpt-4
CONDUCTOR_UI_CONDUCTOR_LLM_API_KEY=

# GitHub App
CONDUCTOR_UI_GITHUB_APP_ID=0
CONDUCTOR_UI_GITHUB_APP_PRIVATE_KEY_PATH=
CONDUCTOR_UI_GITHUB_APP_WEBHOOK_SECRET=

# Frontend URL (for CORS)
CONDUCTOR_UI_FRONTEND_URL=http://localhost:3000
